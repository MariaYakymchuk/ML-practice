   "source": [
    "from xgboost import XGBClassifier\n",
    "from sklearn.metrics import roc_auc_score\n",
    "\n",
    "RANDOM_STATE = 42\n",
    "\n",
    "\n",
    "def evaluate_auc(model, name=''):\n",
    "    \"\"\"Рахує ROC AUC на тренувальному та валідаційному наборах.\"\"\"\n",
    "    train_auc = roc_auc_score(train_targets, model.predict_proba(train_inputs)[:, 1])\n",
    "    val_auc = roc_auc_score(val_targets, model.predict_proba(val_inputs)[:, 1])\n",
    "    print(f'{name} ROC AUC (Train): {train_auc:.4f}')\n",
    "    print(f'{name} ROC AUC (Validation): {val_auc:.4f}')\n",
    "    print(f'{name} Різниця train - val: {train_auc - val_auc:.4f}')\n",
    "    return train_auc, val_auc\n",
    "\n",
    "\n",
    "xgb_clf = XGBClassifier(\n",
    "    max_depth=3,\n",
    "    n_estimators=100,\n",
    "    learning_rate=0.1,\n",
    "    enable_categorical=True,  # XGBoost сам обробляє колонки типу category\n",
    "    missing=np.nan,           # пропущені значення обробляються алгоритмом\n",
    "    tree_method='hist',       # потрібен для enable_categorical\n",
    "    eval_metric='auc',\n",
    "    random_state=RANDOM_STATE,\n",
    ")\n",
    "xgb_clf.fit(train_inputs, train_targets)\n",
    "\n",
    "xgb_train_auc, xgb_val_auc = evaluate_auc(xgb_clf, 'XGBoost')"
   ]
  },
