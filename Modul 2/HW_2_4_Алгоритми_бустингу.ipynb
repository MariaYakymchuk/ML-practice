   "source": [
    "from hyperopt import fmin, tpe, hp, STATUS_OK, Trials\n",
    "from lightgbm import LGBMClassifier\n",
    "\n",
    "INT_PARAMS = ['n_estimators', 'max_depth', 'min_child_weight', 'num_leaves', 'min_child_samples']\n",
    "\n",
    "\n",
    "def cast_params(params):\n",
    "    \"\"\"hyperopt повертає float навіть для quniform - переводимо цілі параметри в int.\"\"\"\n",
    "    return {k: int(v) if k in INT_PARAMS else v for k, v in params.items()}\n",
    "\n",
    "\n",
    "def make_objective(model_class, fixed_params):\n",
    "    \"\"\"Одна objective для будь-якої моделі: передаємо клас моделі і фіксовані параметри.\"\"\"\n",
    "    def objective(params):\n",
    "        clf = model_class(**cast_params(params), **fixed_params)\n",
    "        clf.fit(train_inputs, train_targets)\n",
    "        val_auc = roc_auc_score(val_targets, clf.predict_proba(val_inputs)[:, 1])\n",
    "        return {'loss': -val_auc, 'status': STATUS_OK}  # мінімізуємо негативний AUROC\n",
    "    return objective\n",
    "\n",
    "\n",
    "xgb_fixed_params = dict(\n",
    "    enable_categorical=True,\n",
    "    missing=np.nan,\n",
    "    tree_method='hist',\n",
    "    eval_metric='auc',\n",
    "    random_state=RANDOM_STATE,\n",
    ")\n",
    "\n",
    "xgb_space = {\n",
    "    'n_estimators': hp.quniform('n_estimators', 50, 500, 25),\n",
    "    'learning_rate': hp.loguniform('learning_rate', np.log(0.01), np.log(0.3)),\n",
    "    'max_depth': hp.quniform('max_depth', 2, 8, 1),\n",
    "    'min_child_weight': hp.quniform('min_child_weight', 1, 10, 1),\n",
    "    'subsample': hp.uniform('subsample', 0.5, 1.0),\n",
    "    'colsample_bytree': hp.uniform('colsample_bytree', 0.5, 1.0),\n",
    "    'gamma': hp.uniform('gamma', 0, 0.5),\n",
    "    'reg_alpha': hp.uniform('reg_alpha', 0, 1),\n",
    "    'reg_lambda': hp.uniform('reg_lambda', 0, 1),\n",
    "}\n",
    "\n",
    "xgb_trials = Trials()\n",
    "best_xgb = fmin(\n",
    "    fn=make_objective(XGBClassifier, xgb_fixed_params),\n",
    "    space=xgb_space,\n",
    "    algo=tpe.suggest,\n",
    "    max_evals=20,\n",
    "    trials=xgb_trials,\n",
    "    rstate=np.random.default_rng(RANDOM_STATE),\n",
    ")\n",
    "best_xgb = cast_params(best_xgb)\n",
    "print('Найкращі гіперпараметри XGBoost:', best_xgb)\n",
    "\n",
    "final_clf = XGBClassifier(**best_xgb, **xgb_fixed_params)\n",
    "final_clf.fit(train_inputs, train_targets)\n",
    "\n",
    "final_xgb_train_auc, final_xgb_val_auc = evaluate_auc(final_clf, 'XGBoost (hyperopt)')"
   ]
  },
