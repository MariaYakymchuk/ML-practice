   "source": [
    "raw_df = pd.read_csv('../data/train.csv')\n",
    "\n",
    "target_col = 'Exited'\n",
    "# CustomerId, Surname та id - ідентифікатори, вони не несуть корисної інформації для моделі\n",
    "input_cols = [c for c in raw_df.columns if c not in ['id', 'CustomerId', 'Surname', target_col]]\n",
    "\n",
    "train_df, val_df = split_train_val(raw_df, target_col=target_col)\n",
    "train_inputs, train_targets = separate_inputs_targets(train_df, input_cols, target_col)\n",
    "val_inputs, val_targets = separate_inputs_targets(val_df, input_cols, target_col)\n",
    "\n",
    "print(train_inputs.shape, val_inputs.shape)\n",
    "print('Пропуски в train:', train_inputs.isna().sum().sum())\n",
    "train_inputs.head()"
   ]
  },
